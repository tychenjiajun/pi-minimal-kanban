{
  "name": "pi-minimal-kanban",
  "version": "0.5.1",
  "author": "Jiajun Chen <tychenjiajun@live.cn>",
  "type": "module",
  "description": "Minimal file-backed Kanban for Pi agents: project-specific workflows, exclusive task claims, and a /kanban board view.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tychenjiajun/pi-minimal-kanban.git"
  },
  "homepage": "https://pi.dev/packages/pi-minimal-kanban",
  "bugs": {
    "url": "https://github.com/tychenjiajun/pi-minimal-kanban/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "kanban",
    "task-board",
    "multi-agent",
    "agent-coordination",
    "workflow",
    "markdown",
    "yaml",
    "task-management",
    "agent-orchestration",
    "subagents"
  ],
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "src/**/*.ts",
    "!src/test/**",
    "skills/**",
    "prompts/**",
    "docs/**",
    "assets/**",
    "GLOSSARY.md",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts/*.md"
    ],
    "image": "https://raw.githubusercontent.com/tychenjiajun/pi-minimal-kanban/main/assets/preview.png",
    "video": "https://raw.githubusercontent.com/tychenjiajun/pi-minimal-kanban/main/assets/demo.mp4"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@sinclair/typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@sinclair/typebox": "^0.34.52",
    "@types/node": "^22.10.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@12.6.0"
}
